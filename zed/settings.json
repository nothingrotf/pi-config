// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "collaboration_panel": {
    "button": false,
    "dock": "right",
  },
  "git_panel": {
    "dock": "right",
  },
  "language_models": {
    "opencode": {
      "show_zen_models": false,
    },
  },
  "edit_predictions": {
    "provider": "zed",
  },
  "terminal": {
    "font_weight": 500.0,
    "font_family": "JetBrains Mono NL",
  },
  "buffer_font_weight": 500.0,
  "cli_default_open_behavior": "new_window",
  "agent_servers": {
    "opencode": {
      "type": "registry",
    },
  },
  "show_wrap_guides": true,
  // "ui_font_family": "Geist Mono",
  "ui_font_family": "JetBrains Mono NL",
  // "ui_font_family": ".ZedSans",
  // "buffer_font_family": "Hack",
  "buffer_font_family": "JetBrains Mono NL",
  // "buffer_font_family": "Geist Mono",
  // "buffer_font_family": ".ZedMono",
  "ui_font_size": 15,
  "buffer_font_size": 14,
  "soft_wrap": "editor_width",
  "session": {
    "trust_all_worktrees": true,
  },
  "tab_size": 2,
  "outline_panel": {
    "dock": "right",
    "auto_fold_dirs": false,
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
    "tailwindcss-language-server": {
      "settings": {
        "classFunctions": ["cva", "cx"],
        "experimental": {
          "classRegex": ["[cls|className]\\s\\:\\=\\s\"([^\"]*)"],
        },
      },
    },
  },
  "languages": {
    "JavaScript": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
    },
    "TypeScript": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
    },
    "TSX": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,

        "source.organizeImports.biome": true,
      },
    },
    "JSON": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,

        "source.organizeImports.biome": true,
      },
    },
    "CSS": {
      "language_servers": [
        "tailwindcss-intellisense-css",
        "!vscode-css-language-server",
        "...",
      ],
    },
  },
  "agent": {
    "tool_permissions": {
      "default": "allow",
    },
    "default_model": {
      "effort": "max",
      "provider": "opencode",
      "model": "go/deepseek-v4-flash",
      "enable_thinking": true,
    },
    "inline_assistant_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4-6",
    },
    "default_profile": "ask",
    "dock": "left",
    "model_parameters": [],
  },
  "project_panel": {
    "auto_fold_dirs": false,
    "entry_spacing": "comfortable",
    "hide_gitignore": false,
    "default_width": 400.0,
    "dock": "right",
    "starts_open": false,
    "scrollbar": {
      "show": "never",
    },
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Warm Charmed Icons",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "theme": {
    "mode": "dark",
    "light": "Hearth Light",
    "dark": "Hearth Dark",
  },
  "experimental.theme_overrides": {
    "syntax": {
      "comment": { "font_style": "italic" },
      "comment.doc": { "font_style": "italic" },
      "keyword": { "font_style": "italic" },
    },
  },
  "theme_overrides": {
    "Aura Dark": {
      "editor.document_highlight.read_background": "#00000000",
      "editor.document_highlight.write_background": "#00000000",
      "border.variant": "#141318",
      "border": "#141318",
      "title_bar.background": "#141318",
      "editor.background": "#141318",
      "tab_bar.background": "#141318",
      "toolbar.background": "#141318",
      "panel.background": "#141318",
      "panel.focused_border": "#4E466E",
      "players": [
        {
          "cursor": "#BD9DFF",
        },
      ],
      "syntax": {
        "comment": {
          "font_style": "italic",
        },
        "comment.doc": {
          "font_style": "italic",
        },
      },
    },
  },
  "scrollbar": {
    "show": "never",
  },
  "gutter": {
    "min_line_number_digits": 0,
    "folds": false,
    "runnables": false,
  },
  "buffer_line_height": {
    "custom": 2.4,
  },
  "toolbar": {
    "quick_actions": false,
  },
  "cursor_shape": "block",
  "cursor_blink": false,
  "seed_search_query_from_cursor": "never",
  "current_line_highlight": "none",
  "show_whitespaces": "none",
}
