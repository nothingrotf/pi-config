{
	"$schema": "https://zed.dev/schema/themes/v0.2.0.json",
	"name": "Forge Matter",
	"author": "darkmatter (Steve Simkins) x pi-forge (BareTread), mixed",
	"themes": [
		{
			"name": "Forge Matter",
			"appearance": "dark",
			"style": {
				"background": "#121113",
				"surface.background": "#121113",
				"elevated_surface.background": "#121212",

				"border": "#222222",
				"border.variant": "#1c1c1c",
				"border.focused": "#a0603a",
				"border.selected": "#a0603a",
				"border.transparent": "#00000000",
				"border.disabled": "#22222280",

				"text": "#c1c1c1",
				"text.muted": "#6f6a63",
				"text.placeholder": "#555555",
				"text.disabled": "#333333",
				"text.accent": "#d06a32",

				"icon": "#9c9488",
				"icon.muted": "#6f6a63",
				"icon.disabled": "#333333",
				"icon.accent": "#d06a32",

				"element.background": "#121212",
				"element.hover": "#2a211880",
				"element.active": "#3a2617aa",
				"element.selected": "#3a2617aa",
				"element.disabled": "#12111380",

				"ghost_element.background": "#00000000",
				"ghost_element.hover": "#2a211880",
				"ghost_element.active": "#3a2617aa",
				"ghost_element.selected": "#3a261773",
				"ghost_element.disabled": "#00000000",

				"drop_target.background": "#d06a3220",
				"link_text.hover": "#d3bf92",

				"title_bar.background": "#121113",
				"title_bar.inactive_background": "#121113",
				"status_bar.background": "#121113",
				"toolbar.background": "#121113",
