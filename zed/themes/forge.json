				"editor.invisible": "#333333",
				"editor.wrap_guide": "#222222",
				"editor.active_wrap_guide": "#3a261780",
				"editor.indent_guide": "#1f1f1f",
				"editor.indent_guide_active": "#3a2617",
				"editor.document_highlight.read_background": "#d06a3220",
				"editor.document_highlight.write_background": "#d06a3233",

				"syntax": {
					"attribute": { "color": "#789d7f" },
					"boolean": { "color": "#e06a5f" },
					"comment": { "color": "#715b34", "font_style": "italic" },
					"comment.doc": { "color": "#ac9972", "font_style": "italic" },
					"constant": { "color": "#e06a5f" },
					"constructor": { "color": "#f0975f" },
					"emphasis": { "color": "#d3bf92", "font_style": "italic" },
