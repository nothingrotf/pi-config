					"type": { "color": "#e78a53" },
					"variable": { "color": "#b2bec8" },
					"variable.parameter": { "color": "#c3bbb0" },
					"variable.special": { "color": "#ac9972", "font_style": "italic" }
				},

				"terminal.background": "#121113",
				"terminal.foreground": "#c1c1c1",
				"terminal.ansi.black": "#121113",
				"terminal.ansi.red": "#e06a5f",
				"terminal.ansi.green": "#789d7f",
				"terminal.ansi.yellow": "#d3bf92",
				"terminal.ansi.blue": "#95a7ba",
				"terminal.ansi.magenta": "#d06a32",
				"terminal.ansi.cyan": "#b2bec8",
				"terminal.ansi.white": "#c1c1c1",
				"terminal.ansi.bright_black": "#444444",
				"terminal.ansi.bright_red": "#f0975f",
				"terminal.ansi.bright_green": "#789d7f",
				"terminal.ansi.bright_yellow": "#d06a32",
				"terminal.ansi.bright_blue": "#d2dce4",
				"terminal.ansi.bright_magenta": "#f0975f",
				"terminal.ansi.bright_cyan": "#d2dce4",
				"terminal.ansi.bright_white": "#f5f1ea",

				"error": "#e06a5f",
				"error.background": "#121113",
				"error.border": "#e06a5f40",
				"warning": "#d06a32",
				"warning.background": "#121113",
				"warning.border": "#d06a3240",
				"success": "#789d7f",
				"success.background": "#121113",
				"success.border": "#789d7f40",
				"info": "#95a7ba",
				"info.background": "#121113",
				"info.border": "#95a7ba40",
				"hint": "#6f6a63",

				"created": "#789d7f",
				"modified": "#95a7ba",
				"deleted": "#e06a5f",
				"renamed": "#d3bf92",
				"conflict": "#d06a32",
				"ignored": "#555555",
				"hidden": "#444444",

				"version_control.added": "#789d7f",
				"version_control.modified": "#95a7ba",
				"version_control.deleted": "#e06a5f",

				"players": [
					{ "cursor": "#d06a32", "background": "#d06a32", "selection": "#3a2617aa" },
					{ "cursor": "#789d7f", "background": "#789d7f", "selection": "#789d7f33" },
					{ "cursor": "#d3bf92", "background": "#d3bf92", "selection": "#d3bf9233" },
					{ "cursor": "#f0975f", "background": "#f0975f", "selection": "#f0975f33" },
					{ "cursor": "#95a7ba", "background": "#95a7ba", "selection": "#95a7ba33" },
					{ "cursor": "#e06a5f", "background": "#e06a5f", "selection": "#e06a5f33" },
					{ "cursor": "#b2bec8", "background": "#b2bec8", "selection": "#b2bec833" },
					{ "cursor": "#a0603a", "background": "#a0603a", "selection": "#a0603a33" }
				]
			}
