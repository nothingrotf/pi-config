{
	"$schema": "https://zed.dev/schema/themes/v0.2.0.json",
	"name": "Kaku",
	"author": "tw93/Kaku palette, ported to Zed",
	"themes": [
		{
			"name": "Kaku Dark",
			"appearance": "dark",
			"style": {
				"background": "#15141b",
				"surface.background": "#15141b",
				"elevated_surface.background": "#1f1d28",

				"border": "#2a2833",
				"border.variant": "#22202b",
				"border.focused": "#8e6ad9",
				"border.selected": "#8e6ad9",
				"border.transparent": "#00000000",
				"border.disabled": "#2a283380",

				"text": "#d5d4d6",
				"text.muted": "#8b8a92",
				"text.placeholder": "#6d6d6d",
				"text.disabled": "#4a4954",
				"text.accent": "#8e6ad9",

				"icon": "#c8c6cc",
				"icon.muted": "#8b8a92",
				"icon.disabled": "#4a4954",
				"icon.accent": "#8e6ad9",

				"element.background": "#1f1d28",
				"element.hover": "#29263c80",
				"element.active": "#29263caa",
				"element.selected": "#29263caa",
				"element.disabled": "#1f1d2880",

				"ghost_element.background": "#00000000",
				"ghost_element.hover": "#29263c80",
				"ghost_element.active": "#29263caa",
				"ghost_element.selected": "#29263c73",
				"ghost_element.disabled": "#00000000",

				"drop_target.background": "#8e6ad920",
				"link_text.hover": "#90c9e6",

				"title_bar.background": "#15141b",
				"title_bar.inactive_background": "#15141b",
				"status_bar.background": "#15141b",
				"toolbar.background": "#15141b",
				"tab_bar.background": "#15141b",
				"tab.active_background": "#15141b",
				"tab.inactive_background": "#1f1d28",
				"panel.background": "#15141b",
				"panel.focused_border": "#8e6ad9",
				"panel.indent_guide": "#2a2833",
				"panel.indent_guide_active": "#8e6ad9",
				"pane.focused_border": "#8e6ad9",
				"pane_group.border": "#2a2833",

				"scrollbar.thumb.background": "#8e6ad92f",
				"scrollbar.thumb.hover_background": "#8e6ad95f",
				"scrollbar.thumb.border": "#2a28336f",
				"scrollbar.track.background": "#15141b",
				"scrollbar.track.border": "#00000000",

				"search.match_background": "#8e6ad940",

				"editor.background": "#15141b",
				"editor.foreground": "#d5d4d6",
				"editor.gutter.background": "#15141b",
				"editor.active_line.background": "#1f1d28",
				"editor.highlighted_line.background": "#29263c80",
				"editor.line_number": "#4a4954",
				"editor.active_line_number": "#d5d4d6",
				"editor.invisible": "#4a4954",
				"editor.wrap_guide": "#2a2833",
				"editor.active_wrap_guide": "#3a2f52",
				"editor.indent_guide": "#22202b",
				"editor.indent_guide_active": "#3a2f52",
				"editor.document_highlight.read_background": "#8e6ad920",
				"editor.document_highlight.write_background": "#8e6ad933",

				"syntax": {
					"attribute": { "color": "#58d8ad" },
					"boolean": { "color": "#daae76" },
					"comment": { "color": "#6d6d6d", "font_style": "italic" },
					"comment.doc": { "color": "#8b8a92", "font_style": "italic" },
					"constant": { "color": "#daae76" },
					"constructor": { "color": "#68afda" },
					"emphasis": { "color": "#d383da", "font_style": "italic" },
					"emphasis.strong": { "color": "#d383da", "font_weight": 700 },
					"enum": { "color": "#d383da" },
					"function": { "color": "#68afda" },
					"keyword": { "color": "#8e6ad9" },
					"label": { "color": "#90c9e6" },
					"link_text": { "color": "#58d8ad" },
					"link_uri": { "color": "#90c9e6" },
					"number": { "color": "#daae76" },
					"operator": { "color": "#a98ce4" },
					"property": { "color": "#90c9e6" },
					"punctuation": { "color": "#8b8a92" },
					"punctuation.bracket": { "color": "#8b8a92" },
					"punctuation.delimiter": { "color": "#8b8a92" },
					"punctuation.list_marker": { "color": "#8e6ad9" },
					"punctuation.special": { "color": "#8e6ad9" },
					"string": { "color": "#58d8ad" },
					"string.escape": { "color": "#daae76" },
					"string.regex": { "color": "#58d8ad" },
					"string.special": { "color": "#58d8ad" },
					"string.special.symbol": { "color": "#58d8ad" },
					"tag": { "color": "#8e6ad9" },
					"text.literal": { "color": "#58d8ad" },
					"title": { "color": "#d383da", "font_weight": 700 },
					"type": { "color": "#d383da" },
					"variable": { "color": "#d5d4d6" },
					"variable.parameter": { "color": "#c8c6cc" },
					"variable.special": { "color": "#daae76", "font_style": "italic" }
				},

				"terminal.background": "#15141b",
				"terminal.foreground": "#d5d4d6",
				"terminal.ansi.black": "#3a3942",
				"terminal.ansi.red": "#d85d5d",
				"terminal.ansi.green": "#58d8ad",
				"terminal.ansi.yellow": "#daae76",
				"terminal.ansi.blue": "#68afda",
				"terminal.ansi.magenta": "#8e6ad9",
				"terminal.ansi.cyan": "#58d8ad",
				"terminal.ansi.white": "#d5d4d6",
				"terminal.ansi.bright_black": "#6d6d6d",
				"terminal.ansi.bright_red": "#d85d5d",
				"terminal.ansi.bright_green": "#58d8ad",
				"terminal.ansi.bright_yellow": "#daae76",
				"terminal.ansi.bright_blue": "#90c9e6",
				"terminal.ansi.bright_magenta": "#8e6ad9",
				"terminal.ansi.bright_cyan": "#58d8ad",
				"terminal.ansi.bright_white": "#d5d4d6",

				"error": "#d85d5d",
				"error.background": "#15141b",
				"error.border": "#d85d5d40",
				"warning": "#daae76",
				"warning.background": "#15141b",
				"warning.border": "#daae7640",
				"success": "#58d8ad",
				"success.background": "#15141b",
				"success.border": "#58d8ad40",
				"info": "#68afda",
				"info.background": "#15141b",
				"info.border": "#68afda40",
				"hint": "#6d6d6d",

				"created": "#58d8ad",
				"modified": "#68afda",
				"deleted": "#d85d5d",
				"renamed": "#daae76",
				"conflict": "#d383da",
				"ignored": "#6d6d6d",
				"hidden": "#4a4954",

				"version_control.added": "#58d8ad",
				"version_control.modified": "#68afda",
				"version_control.deleted": "#d85d5d",

				"players": [
					{ "cursor": "#8e6ad9", "background": "#8e6ad9", "selection": "#584384aa" },
					{ "cursor": "#58d8ad", "background": "#58d8ad", "selection": "#58d8ad33" },
					{ "cursor": "#daae76", "background": "#daae76", "selection": "#daae7633" },
					{ "cursor": "#d383da", "background": "#d383da", "selection": "#d383da33" },
					{ "cursor": "#68afda", "background": "#68afda", "selection": "#68afda33" },
					{ "cursor": "#d85d5d", "background": "#d85d5d", "selection": "#d85d5d33" },
					{ "cursor": "#90c9e6", "background": "#90c9e6", "selection": "#90c9e633" },
					{ "cursor": "#a98ce4", "background": "#a98ce4", "selection": "#a98ce433" }
				]
			}
		}
	]
}
