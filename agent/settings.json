{
  "images": {
    "blockImages": false
  },
  "terminal": {
    "showImages": false
  },
  "hideThinkingBlock": true,
  "quietStartup": true,
  "steeringMode": "all",
  "followUpMode": "all",
  "collapseChangelog": true,
  "enableInstallTelemetry": false,
  "warnings": {
    "anthropicExtraUsage": false
  },
  "editorPaddingX": 0,
  "theme": "hearth-dark",
  "defaultProjectTrust": "always",
  "packages": [
    "../../Workspaces/pi-fusiontui",
    "../../Workspaces/pi-harness",
    "npm:@gotgenes/pi-anthropic-auth",
    "npm:pi-codex-goal",
    "npm:pi-mcp-adapter",
    "npm:pi-web-access",
    "npm:@ryan_nookpi/pi-extension-codex-fast-mode",
    "npm:timestamp-pi",
    "npm:@pi-kaush/pi-inline-skill-identifier",
    "git:github.com/nothingrotf/oh-my-pstack@f2b3ee59ff6925a336bee24612b7338f17090a09",
    "npm:pi-subagents"
  ],
  "enabledModels": [
    "anthropic/claude-opus-5",
    "anthropic/claude-fable-5",
    "anthropic/claude-sonnet-5",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-5.6-luna"
  ],
  "lastChangelogVersion": "0.84.4",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "medium",
  "compaction": {
    "enabled": true,
    "reserveTokens": 32000,
    "keepRecentTokens": 12000
  },
  "fullscreenScrollbar": "always",
  "tuiMode": "fullscreen",
  "markdown": {
    "mermaid": "streaming"
  }
}